{
  "name": "360全景",
  "appid": "__UNI__PANORAMA",
  "description": "沉浸式360度全景展示平台",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": { "permissions": [] },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true,
      "minifyWXSS": true,
      "minifyWXML": true,
      "lazyCodeLoading": "requiredComponents"
    },
    "usingComponents": true
  },
  "h5": {
    "title": "360全景",
    "router": { "mode": "hash" },
    "devServer": {
      "port": 5174,
      "proxy": {
        "/api": { "target": "http://localhost:3000", "changeOrigin": true }
      }
    }
  },
  "vueVersion": "3"
}
