.live-list-page{min-height:100vh;background:var(--bg-card);padding-bottom:40rpx}.list{padding:20rpx 24rpx 0}.live-card{background:var(--white);border-radius:var(--radius-md);overflow:hidden;margin-bottom:20rpx}.live-cover{position:relative}.cover-img{width:100%;height:360rpx;display:block}.cover-empty{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f2f3f5,#e5e6eb);color:var(--decor);font-size:30rpx}.live-tag{position:absolute;left:16rpx;top:16rpx;display:flex;align-items:center;gap:8rpx;padding:6rpx 16rpx;border-radius:var(--radius-pill);background:rgba(0,0,0,.55);color:var(--white);font-size:var(--fs-2)}.live-tag.off{background:rgba(0,0,0,.45)}.tag-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--danger)}.live-viewer{position:absolute;right:16rpx;bottom:16rpx;padding:4rpx 12rpx;border-radius:var(--radius-pill);background:rgba(0,0,0,.5);color:var(--white);font-size:var(--fs-1)}.live-info{padding:20rpx 24rpx 24rpx}.live-title{font-size:30rpx;font-weight:600;color:var(--t1);line-height:1.4}.live-meta{display:flex;align-items:center;gap:16rpx;margin-top:10rpx;font-size:var(--fs-3);color:var(--decor)}.empty{display:flex;flex-direction:column;align-items:center;padding:160rpx 0;color:var(--decor);font-size:var(--fs-4)}.empty-icon{font-size:64rpx;margin-bottom:16rpx}.load-more{text-align:center;padding:24rpx;color:var(--decor);font-size:var(--fs-3)}