{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "NODE_ENV=production node src/index.js",
    "test": "node --test --test-concurrency=1",
    "restart": "pkill -f 'node src/index.js' || true; sleep 1; nohup node src/index.js > /tmp/panorama-server.log 2>&1 &"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "qiniu": "^7.15.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}